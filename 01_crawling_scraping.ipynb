    "def api_url(keyword, fromdate, todate, start, limit):\n",
    "    \"\"\"Bangun URL API pencarian CNBC (JSON).\"\"\"\n",
    "    kw = keyword.replace(\" \", \"+\")\n",
    "    return (f\"https://www.cnbcindonesia.com/api/v2/search\"      # <- bisa diubah: endpoint API\n",
    "            f\"?query={kw}&fromdate={fromdate}&todate={todate}&start={start}&limit={limit}\")\n",
    "\n",
    "# Pola URL artikel CNBC: /{kanal}/{YYYYMMDDhhmmss}-{kode_tipe}-{id}/{slug}\n",
    "pola_url = re.compile(r\"/(\\w+)/(\\d{14})-(\\d+)-(\\d+)/\")\n",
    "\n",
    "def ambil_dari_api(keyword, fromdate, todate, maks_artikel, jeda, kanal_dipakai):\n",
    "    \"\"\"Kumpulkan artikel teks satu keyword dari API. Return list dict.\n",
    "    kanal_dipakai = daftar kanal yang diambil (mis. ['market']); None = semua kanal.\"\"\"\n",
    "    limit = 100                              # <- bisa diubah: jumlah artikel per permintaan API\n",
    "    hasil = []\n",
    "    start = 0\n",
    "    while start < maks_artikel:\n",
    "        data = fetch_json(api_url(keyword, fromdate, todate, start, limit))\n",
    "        time.sleep(jeda)\n",
    "        if not data or not data.get(\"data\"):\n",
    "            break                            # habis / gagal\n",
    "        for it in data[\"data\"]:\n",
    "            url = it.get(\"articleUrl\") or it.get(\"url\") or \"\"\n",
    "            m = pola_url.search(url)\n",
    "            if not m:\n",
    "                continue\n",
    "            kanal, ts, kode_tipe, id_artikel = m.groups()\n",
    "            if kanal_dipakai and kanal not in kanal_dipakai:   # filter kanal (mis. hanya 'market')\n",
    "                continue\n",
    "            if kode_tipe in (\"18\", \"19\"):    # <- bisa diubah: kode tipe yang dibuang (video)\n",
    "                continue\n",
    "            judul = (it.get(\"strjudul\") or \"\").strip()\n",
    "            if judul.lower().startswith(\"video\"):   # buang artikel berjudul 'Video:...'\n",
    "                continue\n",
    "            # lengkapi URL bila relatif\n",
    "            if url.startswith(\"/\"):\n",
    "                url = \"https://www.cnbcindonesia.com\" + url\n",
    "            tanggal = f\"{ts[0:4]}-{ts[4:6]}-{ts[6:8]}\"   # dari YYYYMMDDhhmmss -> YYYY-MM-DD\n",
    "            hasil.append({\n",
    "                \"id_artikel\": id_artikel, \"kanal\": kanal, \"url\": url, \"timestamp\": tanggal,\n",
    "                \"judul\": judul,\n",
    "                \"isi\": bersikan_html(it.get(\"strisi\", \"\")),\n",
    "            })\n",
    "        if len(data[\"data\"]) < limit:        # halaman terakhir\n",
    "            break\n",
    "        start += limit\n",
    "    return hasil"
   ]
