    "def jalankan(keywords, fromdate, todate, maks_artikel, jeda, output_csv, kanal_dipakai):\n",
    "    output_csv = Path(output_csv)            # <- bisa diubah lewat argumen; dibungkus Path agar .parent/.exists() aman\n",
    "    output_csv.parent.mkdir(parents=True, exist_ok=True)\n",
    "    header = [\"id_artikel\", \"keyword\", \"url\", \"timestamp\", \"judul\", \"isi_mentah\"]\n",
    "\n",
    "    # safeguard: kumpulkan id_artikel yang sudah tersimpan (resume + dedupe)\n",
    "    sudah = set()\n",
    "    if output_csv.exists():\n",
    "        with open(output_csv, \"r\", encoding=\"utf-8\", newline=\"\") as f:\n",
    "            for row in csv.DictReader(f):\n",
    "                sudah.add(str(row.get(\"id_artikel\", \"\")))\n",
    "    print(f\"[RESUME] {len(sudah)} artikel sudah ada, akan dilewati.\\n\")\n",
    "\n",
    "    file_baru = not output_csv.exists()\n",
    "    f = open(output_csv, \"a\", encoding=\"utf-8\", newline=\"\", buffering=1)  # line-buffered (aman bila terputus)\n",
    "    writer = csv.DictWriter(f, fieldnames=header)\n",
    "    if file_baru:\n",
    "        writer.writeheader()\n",
    "\n",
    "    n_baru = 0\n",
    "    for keyword in keywords:\n",
    "        artikel = ambil_dari_api(keyword, fromdate, todate, maks_artikel, jeda, kanal_dipakai)\n",
    "        print(f\"=== keyword '{keyword}': {len(artikel)} artikel dari API ===\")\n",
    "        for a in artikel:\n",
    "            if a[\"id_artikel\"] in sudah:\n",
    "                continue   # sudah pernah (keyword lain / run sebelumnya) -> dedupe\n",
    "            writer.writerow({\n",
    "                \"id_artikel\": a[\"id_artikel\"], \"keyword\": keyword,\n",
    "                \"url\": a[\"url\"], \"timestamp\": a[\"timestamp\"], \"judul\": a[\"judul\"],\n",
    "                \"isi_mentah\": a[\"isi\"],\n",
    "            })\n",
    "            sudah.add(a[\"id_artikel\"])\n",
    "            n_baru += 1\n",
    "            print(f\"  [{keyword}] +{a['judul'][:60]}\")\n",
    "\n",
    "    f.close()\n",
    "    print()\n",
    "    print(f\"selesai, {n_baru} artikel baru ditambahkan sesi ini -> {output_csv}\")\n",
    "    return output_csv"
   ]
  },
