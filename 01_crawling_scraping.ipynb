    "def fetch_json(url):\n",
    "    \"\"\"Unduh JSON dari API dengan retry + backoff. Return dict/list atau None.\"\"\"\n",
    "    headers = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n",
    "                             \"AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36\",  # <- bisa diubah (User-Agent)\n",
    "               \"Accept\": \"application/json\"}\n",
    "    for percobaan in range(1, 4):            # <- bisa diubah: jumlah percobaan (retry) = 3\n",
    "        try:\n",
    "            r = requests.get(url, headers=headers, timeout=30)   # <- bisa diubah: timeout detik = 30\n",
    "            if r.status_code == 200:\n",
    "                return r.json()\n",
    "            if r.status_code in (404, 410):\n",
    "                return None\n",
    "        except (requests.RequestException, ValueError) as e:\n",
    "            print(f\"    [ERR] {percobaan}/3: {type(e).__name__}\")\n",
    "        time.sleep(2 ** percobaan)           # backoff: 2s, 4s, 8s\n",
    "    return None\n",
    "\n",
    "def bersikan_html(html):\n",
    "    \"\"\"Ubah isi artikel (HTML dari field strisi) menjadi teks bersih.\"\"\"\n",
    "    if not html:\n",
    "        return \"\"\n",
    "    soup = BeautifulSoup(html, \"lxml\")\n",
    "    # buang elemen non-teks + blok video sisipan\n",
    "    for buang in soup.find_all([\"script\", \"style\", \"iframe\"]):\n",
    "        buang.decompose()\n",
    "    for v in soup.find_all(\"a\", class_=re.compile(r\"autovideocnbc\")):\n",
    "        v.decompose()\n",
    "    teks = soup.get_text(\" \", strip=True)\n",
    "    teks = re.sub(r\"\\[Gambas:[^\\]]*\\]\", \" \", teks)                          # buang penanda embed\n",
    "    teks = re.sub(r\"\\(\\s*[a-z]{2,4}\\s*/\\s*[a-z]{2,4}\\s*\\)\\s*$\", \"\", teks).strip()  # buang kode penulis (rob/rob)\n",
    "    teks = re.sub(r\"\\s+\", \" \", teks).strip()\n",
    "    return teks"
   ]
